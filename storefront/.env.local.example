# Copier en ".env.local" et renseigner la clé publique affichée à la fin du script de démonstration
# (npx medusa exec ./src/scripts/seed-marketplace.ts, dans le dossier backend).
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Stripe: activer le composant de paiement sécurisé avec la clé publique Stripe.
# La clé secrète STRIPE_API_KEY reste uniquement dans backend/.env.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Réservé au test local d'un build de production; ne jamais activer en ligne.
DEMO_CHECKOUT_ENABLED=

# À mettre à true derrière HTTPS (cookie du panier marqué « Secure »). Laisser vide en local.
COOKIE_SECURE=
